# 运行环境标识。
# 可选值：dev、test、prod，也可以填自定义字符串，主要用于日志和部署区分。
APP_ENV=dev

# HTTP 服务监听地址，用于健康检查和飞书 Webhook 回调。
# 示例：:8080、127.0.0.1:8080、0.0.0.0:8080
HTTP_ADDR=:8080

# 飞书事件接收模式。
# 可选值：
# - webhook：推荐服务器部署使用。飞书会把事件 POST 到 WEBHOOK_PATH。
# - websocket：适合本地或内网测试。服务主动和飞书建立长连接。
EVENT_MODE=webhook

# Webhook 路径，仅 EVENT_MODE=webhook 时使用。
# 飞书开放平台里的事件请求地址应配置为：https://你的域名/feishu/events
WEBHOOK_PATH=/feishu/events

# 飞书开放平台应用凭证。
# 必填。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书事件 Verification Token。
# 如果飞书事件订阅里配置了 Verification Token，这里也要填写；否则留空。
FEISHU_VERIFICATION_TOKEN=

# 飞书事件 Encrypt Key。
# 如果飞书事件加密已开启，这里必须填写；否则留空。
FEISHU_ENCRYPT_KEY=

# 用户消息处理状态表情 1：刚收到消息时添加。
# 留空表示不添加该状态表情。
# 常见值取决于飞书支持的 emoji 类型，例如：OK、THUMBSUP、Get。
REACTION_RECEIVED_EMOJI=OK

# 用户消息处理状态表情 2：消息已转发给大模型时替换为该表情。
# 留空表示不添加该状态表情。
REACTION_PROCESSING_EMOJI=Thinking

# 用户消息处理状态表情 3：机器人完成回复后替换为该表情。
# 留空表示不添加该状态表情。
REACTION_DONE_EMOJI=DONE

# 是否打印飞书原始消息内容。
# 可选值：true、false
# 调试消息格式时建议开启；生产环境如果日志可能包含敏感内容，建议关闭。
LOG_RAW_MESSAGE=true

# 机器人回复消息的飞书格式。
# 可选值：
# - markdown_card：使用飞书交互卡片渲染 Markdown，推荐。
# - text：普通文本消息，不渲染 Markdown。
REPLY_FORMAT=markdown_card

# 客服身份和行为提示词文件。
# 每个话题会话都会基于这个文件构建系统提示。
PROMPT_FILE=configs/customer_service.md

# OpenAI-compatible API 基础地址。
# 程序实际请求地址为：LLM_BASE_URL + /chat/completions
# 示例：https://api.openai.com/v1、https://cooper-api.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# OpenAI-compatible API Key。
# 必填。
LLM_API_KEY=

# 传给 OpenAI-compatible API 的模型名称。
# 示例：gpt-4.1-mini、gemini-3-flash-preview、openai-completions
LLM_MODEL=gpt-4.1-mini

# 大模型请求超时时间。
# 单位：秒。
LLM_TIMEOUT_SECONDS=60

# 是否打印大模型请求摘要。
# 可选值：true、false
# 图片 base64 会被截断显示，但文本提示词仍可能包含用户内容。
LOG_LLM_REQUEST=true

# 是否启用流式输出。
# 可选值：
# - true：先回复“正在处理...”，再持续更新同一条飞书消息。
# - false：等待大模型完整返回后，只回复一次。
LLM_STREAM=true

# 流式输出开启时，先回复给用户的占位文本。
# 留空表示不发送占位消息，等大模型返回后再回复。
STREAM_PLACEHOLDER=正在处理...

# 流式输出时，更新飞书消息的最小间隔。
# 单位：毫秒。
STREAM_UPDATE_INTERVAL_MS=800

# 每个话题会话携带的最近历史消息数量。
MAX_HISTORY_MESSAGES=20

# 会话历史来源。
# 可选值：
# - memory：使用进程内存保存最近对话，适合本地开发。
# - feishu：每次从飞书当前话题拉取最近消息，不长期保存聊天历史。
HISTORY_SOURCE=memory

# 仅 HISTORY_SOURCE=feishu 且遇到非话题容器兜底时预留；话题 thread 拉取不支持时间范围。
# 单位：小时。
FEISHU_HISTORY_LOOKBACK_HOURS=168

# 本地消息去重缓存时间。
# 单位：秒。
# 用于避免飞书重试或重复投递导致机器人重复回复。
MESSAGE_DEDUPE_TTL_SECONDS=3600

# 消息去重存储。
# 可选值：
# - memory：本机内存去重，适合本地开发。
# - redis：使用 Redis SET NX EX 去重，适合服务器和多实例部署。
DEDUPE_STORE=memory

# Redis 连接串，仅 DEDUPE_STORE=redis 时使用。
# 示例：redis://:password@127.0.0.1:6379/0
REDIS_CONN_STRING=

# 本地 Markdown/TXT 知识库目录。
KNOWLEDGE_DIR=knowledge

# 知识库检索模式。
# 可选值：
# - auto：配置了 DATABASE_URL 和 EMBEDDING_API_KEY 时使用 RAG，否则使用本地 Markdown 检索。
# - rag：优先使用 PostgreSQL/pgvector RAG，配置缺失时回退到本地 Markdown 检索。
# - local：始终使用本地 Markdown/TXT 关键词检索。
KNOWLEDGE_MODE=auto

# RAG 检索返回的 chunk 数量。
KNOWLEDGE_TOP_K=5

# 知识库索引时的 chunk 大小和重叠字符数。
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_CHUNK_OVERLAP=120

# PostgreSQL/pgvector 连接地址。
# 示例：postgres://user:pass@localhost:5432/aics?sslmode=disable
DATABASE_URL=

# Embedding 配置。
# EMBEDDING_BASE_URL 留空时直连 Google Gemini 官方接口。
# 使用第三方中转时填写 Gemini 网关前缀，例如：https://example.com/v1beta
# 程序会请求：EMBEDDING_BASE_URL + /models/{EMBEDDING_MODEL}:embedContent
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
# gemini-embedding-2 默认 3072 维，这里固定使用 768 维，需要和 pgvector 字段 vector(768) 保持一致。
EMBEDDING_DIMENSIONS=768

# 是否启用外部脚本技能系统。
# 可选值：true、false
# - true：启动时扫描 SKILLS_DIR，把技能索引注入给大模型，并允许模型调用 run_skill。
# - false：不加载外部技能。
SKILLS_ENABLED=true

# 外部技能目录。
# 每个技能一个子目录，子目录内需要有 skill.json。
# 示例：skills/compare_best_price/skill.json
SKILLS_DIR=skills

# 单次技能 workflow 最多执行多少个步骤。
# 用于防止 LLM 步骤循环跳转。
SKILL_MAX_STEPS=8

# 单个脚本步骤的超时时间。
# 单位：秒。
SKILL_SCRIPT_TIMEOUT_SECONDS=30

# 图片消息传给大模型的方式。
# 可选值：
# - base64：从飞书下载图片后，转成 data:image/...;base64,... 直接发给视觉模型。
# - upload：先上传到 IMAGE_HOST_UPLOAD_URL，再把图床返回的公网 URL 发给模型。
IMAGE_INPUT_MODE=base64

# 图床上传地址，仅 IMAGE_INPUT_MODE=upload 时使用。
IMAGE_HOST_UPLOAD_URL=

# 图床上传接口的鉴权 Header 名。
# 示例：Authorization、X-API-Key
# 如果图床不需要鉴权，留空。
IMAGE_HOST_AUTH_HEADER=

# 图床上传接口的鉴权 Header 值。
# 示例：Bearer xxx、sk-xxx
# 如果图床不需要鉴权，留空。
IMAGE_HOST_AUTH_VALUE=

# multipart 上传时的文件字段名。
# 常见值：file、image、upload
IMAGE_HOST_FIELD_NAME=file

# 从图床返回 JSON 中读取图片 URL 的路径。
# 支持点号路径。
# 示例：url、data.url、result.image_url
IMAGE_HOST_RESPONSE_URL_PATH=url
